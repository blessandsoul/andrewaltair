# Andrew Altair - Environment Variables
# Copy this file to .env.local and fill in your values

# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# NextAuth Secret (generate random string)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here

# Base URL for your app
NEXTAUTH_URL=http://localhost:3000

# Admin Panel Security
# Generate a strong password for admin access
ADMIN_PASSWORD=your_secure_admin_password_2026!
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=your_32_char_secret_for_session_signing

# Optional: Email configuration for notifications
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email
# SMTP_PASS=your_password

# Google Analytics 4
# Get from: https://analytics.google.com
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Public Site URL (for sitemap and SEO)
NEXT_PUBLIC_SITE_URL=https://andrewaltair.ge
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Stable Server Actions encryption key (base64 32 bytes). Set the SAME value in Coolify env.
# Generate: node -e "console.log(require("crypto").randomBytes(32).toString("base64"))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# LiveKit (workshop host video/audio broadcast). Self-hosted server, see deploy/livekit/README.md.
# LIVEKIT_API_KEY / LIVEKIT_API_SECRET must match the key:secret pair in livekit.yaml.
# Generate a pair: docker run --rm livekit/livekit-server generate-keys
LIVEKIT_URL=wss://livekit.andrewaltair.ge
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Same wss url, exposed to the browser (signaling endpoint).
NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.andrewaltair.ge

# PHONE_CAMERA signaling (use the iPhone as the broadcast camera source, no OBS).
# Run github.com/andrewaltair/PHONE_CAMERA server.js on the presenter laptop; the workshop
# page connects as a viewer. Phone + laptop must share a LAN. Optional PHONE_URL enables a QR.
NEXT_PUBLIC_PHONE_CAMERA_WS=wss://localhost:8443
# NEXT_PUBLIC_PHONE_CAMERA_PHONE_URL=https://192.168.1.50:8443/phone.html
